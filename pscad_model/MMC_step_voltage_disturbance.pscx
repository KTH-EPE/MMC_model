          <script>
            <segment name="Computations"><![CDATA[INTEGER Inputs = (A!=0)+(B!=0)+(C!=0)+(D!=0)+(E!=0)+(F!=0)+(G!=0)
]]></segment>
            <segment name="Checks"><![CDATA[ERROR Summing Junction must have two or more inputs : Inputs>=2
]]></segment>
            <segment name="Fortran"><![CDATA[      $OUT =~
#CASE A+1  {~ - $INA~} {~~} {~ + $INA~}
#CASE B+1  {~ - $INB~} {~~} {~ + $INB~}
#CASE C+1  {~ - $INC~} {~~} {~ + $INC~}
#CASE D+1  {~ - $IND~} {~~} {~ + $IND~}
#CASE E+1  {~ - $INE~} {~~} {~ + $INE~}
#CASE F+1  {~ - $INF~} {~~} {~ + $INF~}
#CASE G+1  {~ - $ING}  {~}  {~ + $ING}]]></segment>
            <segment name="FlyBy"><![CDATA[
:INA
Input A
:INB
Input B
:INC
Input C
:IND
Input D
:INE
Input E
:INF
Input F
:ING
Input G
:OUT
Output]]></segment>
          </script>
